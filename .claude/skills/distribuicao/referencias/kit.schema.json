{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kit de distribuição de um post (posts/<slug>/distribuicao/kit.json), versão 1.0",
  "description": "Contrato com o ../uther-pendragon. Gerado só por scripts/kit.py. Qualquer mudança exige versao_esquema nova e aviso no relatório.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao_esquema", "post", "pecas"],
  "$defs": {
    "data": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "properties": {
    "versao_esquema": {"const": "1.0"},
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "linha", "titulo", "data_publicacao", "url"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "linha": {"enum": ["notas-de-um-professor", "spoiler"]},
        "titulo": {"type": "string", "minLength": 1},
        "data_publicacao": {"$ref": "#/$defs/data"},
        "url": {"type": ["string", "null"]}
      }
    },
    "pecas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tipo", "canais", "offset_dias", "data", "arquivos", "producao_manual",
                     "apetite_min", "situacao", "retorno"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "tipo": {"enum": ["note", "video", "post-linkedin", "carrossel"]},
          "canais": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["substack-notes", "linkedin", "instagram", "instagram-reels", "youtube-shorts"]}
          },
          "offset_dias": {"type": "integer", "minimum": 0},
          "data": {"$ref": "#/$defs/data"},
          "arquivos": {"type": "array", "items": {"type": "string"}},
          "producao_manual": {"type": "array", "items": {"type": "string"}},
          "apetite_min": {"type": "integer", "minimum": 0},
          "situacao": {"enum": ["pronto", "aguarda-url", "aguarda-producao"]},
          "retorno": {"type": "string"}
        }
      }
    }
  }
}
