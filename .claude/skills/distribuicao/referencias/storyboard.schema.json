{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard do vídeo D+1 (posts/<slug>/distribuicao/video/storyboard.json), versão 1.0",
  "description": "Contrato com o ../spielberg, que só lê. Validado por scripts/storyboard.py. Qualquer mudança exige versao_esquema nova e aviso no relatório.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao_esquema", "post", "estrategia", "formato", "tomadas", "cenas", "capa", "legenda", "fechamento"],
  "$defs": {
    "texto": {"type": "string"},
    "cartao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modo", "chassi"],
      "properties": {
        "id": {"type": "string", "pattern": "^C\\d+$"},
        "modo": {"enum": ["sobreposto", "cheio"]},
        "chassi": {"enum": ["A", "B", "C", "D", "E"], "description": "brand/SOCIAL.md §6"},
        "eyebrow": {"$ref": "#/$defs/texto"},
        "texto": {"$ref": "#/$defs/texto"},
        "destaque": {"$ref": "#/$defs/texto"},
        "rodape": {"$ref": "#/$defs/texto", "description": "fonte do número ou aviso legal, corpo pequeno"},
        "segurar_s": {"type": "number", "minimum": 0, "description": "cartão depois da última fala da cena, por N segundos (cartão final)"},
        "ordem": {"type": "array", "items": {"enum": ["destaque", "texto"]}, "description": "padrão: destaque numérico abre, destaque em palavras fecha"}
      }
    }
  },
  "properties": {
    "versao_esquema": {"const": "1.0"},
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "linha", "titulo", "data_video"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "linha": {"enum": ["notas-de-um-professor", "spoiler"]},
        "titulo": {"type": "string", "minLength": 1},
        "data_video": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "calculada por script: data da peça de vídeo no kit.json"}
      }
    },
    "estrategia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segmento", "estagio_funil", "cta"],
      "properties": {
        "segmento": {"enum": ["#Millennials-FEAR", "#Millennials-GREED", "#GENZ-FEAR", "#GENZ-GREED"]},
        "eixo": {"enum": ["FEAR", "GREED"]},
        "estagio_funil": {"type": "string", "minLength": 1},
        "cta": {"type": "string", "minLength": 1}
      }
    },
    "formato": {
      "type": "object",
      "additionalProperties": false,
      "required": ["largura", "altura", "fps", "duracao_alvo_s"],
      "properties": {
        "largura": {"const": 1080},
        "altura": {"const": 1920},
        "fps": {"const": 30},
        "duracao_alvo_s": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
      }
    },
    "tomadas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bloco", "fala"],
        "properties": {
          "id": {"type": "string", "pattern": "^T\\d+$"},
          "bloco": {"type": "string", "minLength": 1},
          "fala": {"type": "string", "minLength": 1, "description": "texto literal que o autor fala, uma frase por linha"},
          "enquadramento": {"type": "string"},
          "nota": {"type": "string"},
          "excecao": {"type": "string", "description": "motivo registrado para passar do limite de duração da tomada"}
        }
      }
    },
    "cenas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tomada", "ancora_inicio", "ancora_fim", "visual"],
        "properties": {
          "id": {"type": "string", "pattern": "^S\\d+$"},
          "tomada": {"type": "string", "pattern": "^T\\d+$"},
          "ancora_inicio": {"type": "string", "minLength": 1},
          "ancora_fim": {"type": "string", "minLength": 1},
          "visual": {"enum": ["camera", "grafico", "insercao"]},
          "cartao": {"$ref": "#/$defs/cartao"},
          "grafico": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arquivo"],
            "properties": {"arquivo": {"type": "string"}, "movimento": {"type": "string"}}
          },
          "zoom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["de", "para"],
            "properties": {"de": {"type": "number"}, "para": {"type": "number", "minimum": 1, "maximum": 1.5}, "alvo": {"type": "string"}}
          },
          "numeros": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["valor", "fonte"],
              "properties": {"valor": {"type": "string"}, "fonte": {"type": "string", "description": "trecho literal do post que traz o número e a fonte"}}
            }
          }
        }
      }
    },
    "capa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chassi", "texto"],
      "properties": {
        "chassi": {"enum": ["A", "B", "C"]},
        "eyebrow": {"type": "string"},
        "texto": {"type": "string", "minLength": 1},
        "destaque": {"type": "string"}
      }
    },
    "legenda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palavras_por_bloco_max", "destaque_palavra_falada"],
      "properties": {
        "palavras_por_bloco_max": {"type": "integer", "minimum": 1, "maximum": 8},
        "destaque_palavra_falada": {"type": "boolean"}
      }
    },
    "fechamento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pergunta", "convite"],
      "properties": {"pergunta": {"type": "string", "minLength": 1}, "convite": {"type": "string", "minLength": 1}}
    }
  }
}
